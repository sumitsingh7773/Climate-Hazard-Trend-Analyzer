# MongoDB Atlas connection string. Keep secrets in .env, never commit it.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=climate_hazard_analyzer
FRONTEND_ORIGIN=https://climate-hazard-trend-analyzer-silk.vercel.app,http://localhost:5173
API_RATE_LIMIT=60/minute
